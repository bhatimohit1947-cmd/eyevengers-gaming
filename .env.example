# ============================================================================
# EYEVENGERS FESTIVE REWARDS — ENVIRONMENT CONFIGURATION
# ============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session Security (Minimum 32 characters random secret)
JWT_SECRET="eyevengers-festive-rewards-secret-key-jodhpur-2026-minimum-32-chars"

# Node Environment
NODE_ENV="development"

# ----------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (Optional in local dev mode)
# In standalone local mode, the built-in ACID database engine automatically
# runs with full transactions and zero external dependencies.
# When deploying to Supabase Cloud, provide your project credentials below:
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-privileged-key"

# ----------------------------------------------------------------------------
# SMS Gateway Provider (Optional)
# In development mode, OTPs are logged directly in the terminal console and 
# simulated in the reset flow.
# In production, provide API keys for Gupshup, Fast2SMS, or Twilio:
# ----------------------------------------------------------------------------
SMS_GATEWAY_PROVIDER="development"
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID="EYEVNG"
